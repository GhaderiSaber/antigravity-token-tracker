[Desktop Entry]
Type=Application
Name=Antigravity Token Tracker Tray
Comment=Native Linux Top-Bar Indicator and 1-Click Switcher for Google Antigravity
Exec=sh -c "$HOME/.local/bin/agy-token tray"
Icon=utilities-terminal
Terminal=false
Categories=Utility;Development;
StartupNotify=false
X-GNOME-Autostart-enabled=true
